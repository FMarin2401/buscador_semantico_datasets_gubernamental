# Copiar este archivo como .env antes de "docker compose up --build". El .env real nunca se sube al repositorio.

# Clave para firmar los JWT. Para la entrega local sirve este valor; en un servidor real usa una cadena aleatoria:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=cambia_esta_clave_por_una_cadena_larga_y_aleatoria

# Administrador inicial (se crea en el primer arranque si no hay usuarios)
ADMIN_USER=admin_leon
ADMIN_PASSWORD=Admin_Leon_2026

# PostgreSQL del contenedor "db" (solo accesible desde la API)
POSTGRES_USER=portal
POSTGRES_PASSWORD=portal_local
POSTGRES_DB=portal_datos

# Puerto de la aplicación web en tu computadora: http://localhost:8080
PUERTO_WEB=8080
# Debe coincidir con la URL de la aplicación web
ALLOWED_ORIGINS=http://localhost:8080

# Opcionales
# LOG_LEVEL=DEBUG             # Detalle de cada búsqueda en los logs
# GEMINI_API_KEY=tu_api_key   # Solo para generar metadatos con api/scripts/analyze_csv.py (no se usa al ejecutar la app)
