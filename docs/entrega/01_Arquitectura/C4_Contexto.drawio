<mxfile host="drawio" type="device"><diagram id="C4 Contexto" name="C4 Contexto"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b style='font-size:22px'&gt;Diagrama de contexto (C4 nivel 1)&lt;/b&gt;&amp;nbsp;&amp;nbsp;Portal de Datos Abiertos de León" style="text;html=1;align=left;verticalAlign=middle;fontColor=#1a1a1a;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="40" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b style='font-size:16px'&gt;Ciudadano&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;[Persona]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Busca datos públicos con sus propias palabras, los consulta y descarga, y reporta errores en los datos." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontColor=#ffffff;fontSize=13;spacing=10;fillColor=#08427B;strokeColor=#052E56;" vertex="1" parent="1"><mxGeometry x="100" y="110" width="300" height="170" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b style='font-size:16px'&gt;Funcionario municipal&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;[Persona]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Publica y actualiza los conjuntos de datos, atiende los reportes y el buzón ciudadano. Puede ser administrador o editor." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontColor=#ffffff;fontSize=13;spacing=10;fillColor=#08427B;strokeColor=#052E56;" vertex="1" parent="1"><mxGeometry x="1100" y="110" width="300" height="170" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b style='font-size:16px'&gt;Portal de Datos Abiertos de León&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;[Sistema]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Permite encontrar datos del municipio escribiendo como se habla (por ejemplo, &amp;quot;dónde tiro mis llantas viejas&amp;quot;), descargarlos en varios formatos y reportar problemas en ellos." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontColor=#ffffff;fontSize=13;spacing=10;fillColor=#1168BD;strokeColor=#0B4884;fontSize=14;" vertex="1" parent="1"><mxGeometry x="480" y="400" width="460" height="210" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b style='font-size:16px'&gt;Dependencias municipales&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;[Organización externa]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Movilidad, Salud, Medio Ambiente y demás áreas que generan los archivos de datos." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontColor=#ffffff;fontSize=13;spacing=10;fillColor=#8C8C8C;strokeColor=#6B6B6B;" vertex="1" parent="1"><mxGeometry x="1100" y="430" width="300" height="150" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b style='font-size:16px'&gt;Google Gemini&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;[Sistema externo]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Servicio de inteligencia artificial que propone título, descripción y categoría para cada archivo nuevo." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontColor=#ffffff;fontSize=13;spacing=10;fillColor=#8C8C8C;strokeColor=#6B6B6B;" vertex="1" parent="1"><mxGeometry x="250" y="740" width="320" height="150" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b style='font-size:16px'&gt;Hugging Face&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;[Sistema externo]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Repositorio público del que se obtiene el modelo de lenguaje que entiende las búsquedas." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontColor=#ffffff;fontSize=13;spacing=10;fillColor=#8C8C8C;strokeColor=#6B6B6B;" vertex="1" parent="1"><mxGeometry x="850" y="740" width="320" height="150" as="geometry"/></mxCell><mxCell id="c9" value="Busca, consulta y descarga datos;&lt;br&gt;reporta problemas y escribe al buzón" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=12;fontColor=#333333;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 4;edgeStyle=none;" edge="1" parent="1" source="c3" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value="Publica y edita datasets;&lt;br&gt;atiende reportes y mensajes" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=12;fontColor=#333333;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 4;edgeStyle=none;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="Entregan sus&lt;br&gt;archivos de datos" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=12;fontColor=#333333;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 4;edgeStyle=none;" edge="1" parent="1" source="c6" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="Pide descripciones para&lt;br&gt;los archivos nuevos" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=12;fontColor=#333333;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 4;edgeStyle=none;" edge="1" parent="1" source="c5" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="Descarga el modelo de lenguaje&lt;br&gt;(una sola vez, al instalar)" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=12;fontColor=#333333;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 4;edgeStyle=none;" edge="1" parent="1" source="c5" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="&lt;b&gt;Leyenda&lt;/b&gt;&lt;br&gt;&lt;span style='color:#08427B'&gt;&amp;#9632;&lt;/span&gt; Persona&amp;nbsp;&amp;nbsp;&lt;span style='color:#1168BD'&gt;&amp;#9632;&lt;/span&gt; Sistema que construimos&amp;nbsp;&amp;nbsp;&lt;span style='color:#8C8C8C'&gt;&amp;#9632;&lt;/span&gt; Sistema u organización externa&lt;br&gt;Las flechas indican quién usa a quién y para qué." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="920" width="700" height="55" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>