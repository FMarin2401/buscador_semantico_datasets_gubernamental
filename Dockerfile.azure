# Imagen para Azure Container Apps: API y frontend en un solo contenedor, con SQLite efímera.
# Se construye desde la raíz del repositorio:
#   docker build -f Dockerfile.azure -t acrportaldatos6462.azurecr.io/portal-datos-leon:vN .
# Para docker compose (tres contenedores) se usan api/Dockerfile y frontend/Dockerfile.
FROM python:3.12-slim

# Evitar que Python escriba archivos .pyc y forzar salida de logs inmediata en consola
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

# Instalar dependencias del sistema necesarias para compilar librerías y LXML
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libxml2-dev \
    libxslt-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copiar e instalar requirements primero
COPY api/requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Precargar el modelo de Hugging Face en la imagen para arranque inmediato
RUN python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('intfloat/multilingual-e5-small')"

# Código de la API y frontend (FastAPI renderiza las plantillas desde /app/frontend, ver api/app/api/pages.py).
# Sin volumen en Azure, la ChromaDB y los CSV que se copian de api/data son los datasets que sirve la app.
COPY api/ .
COPY frontend/ frontend/

# Exponer el puerto de FastAPI
EXPOSE 8000

# Comando para iniciar la aplicación
# --proxy-headers hace que Uvicorn respete X-Forwarded-Proto (Azure termina el HTTPS). La IP del rate limit
# no depende de esto: con "*" Uvicorn toma la primera IP de X-Forwarded-For, que detrás de un proxy que conserve
# la cabecera podría inventar el cliente; app/limiter.py usa la última, la que agrega el proxy más cercano.
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--forwarded-allow-ips=*"]
